{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-editor",
  "version": "0.1.0",
  "identifier": "com.rdenker.md-editor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "NoteBuddy",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri: customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost ws://ipc.localhost tauri: http://tauri.localhost",
        "img-src": "'self' asset: http://asset.localhost tauri: http://tauri.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "script-src": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
